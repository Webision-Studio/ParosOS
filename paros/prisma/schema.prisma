generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  address         String?
  city            String?
  phone           String?
  email           String?
  gstin           String?
  fssai           String?
  plan            String          @default("SILVER")
  qrMode          String          @default("MODE_A")
  upiId           String?
  enableKds       Boolean         @default(true)
  enableWhatsapp  Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cashierPin      String?         @default("1234")
  closingTime     String?         @default("23:00")
  googleReviewUrl String?
  kitchenPin      String?         @default("7788")
  wifiName        String?
  wifiPassword    String?
  bills           Bill[]
  shifts          CashShift[]
  categories      Category[]
  coupons         Coupon[]
  customers       Customer[]
  expenses        Expense[]
  inventoryItems  InventoryItem[]
  menuItems       MenuItem[]
  orders          Order[]
  tables          Table[]
  users           User[]
  zones           Zone[]
}

model User {
  id          String      @id @default(cuid())
  cafeId      String
  name        String
  phone       String?
  email       String?
  role        String      @default("OWNER")
  firebaseUid String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  pin         String?
  shifts      CashShift[]
  cafe        Tenant      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

model Zone {
  id        String  @id @default(cuid())
  cafeId    String
  name      String
  sortOrder Int     @default(0)
  tables    Table[]
  cafe      Tenant  @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

model Table {
  id            String   @id @default(cuid())
  cafeId        String
  zoneId        String?
  tableNumber   String
  capacity      Int      @default(4)
  currentStatus String   @default("AVAILABLE")
  activeOrderId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
  cafe          Tenant   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  zone          Zone?    @relation(fields: [zoneId], references: [id])
}

model Category {
  id        String     @id @default(cuid())
  cafeId    String
  name      String
  icon      String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  cafe      Tenant     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]
}

model MenuItem {
  id              String               @id @default(cuid())
  cafeId          String
  categoryId      String
  name            String
  description     String?
  price           Float
  isVeg           Boolean              @default(true)
  inStock         Boolean              @default(true)
  prepTimeMinutes Int                  @default(8)
  imageUrl        String?
  addons          Json?
  cafe            Tenant               @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  category        Category             @relation(fields: [categoryId], references: [id])
  recipes         MenuItemIngredient[]
  orderItems      OrderItem[]
}

model Order {
  id                 String      @id @default(cuid())
  cafeId             String
  tableId            String?
  orderNumber        String
  source             String      @default("POS")
  status             String      @default("PLACED")
  dynamicPrepMinutes Int         @default(10)
  prepStartedAt      DateTime?
  readyAt            DateTime?
  customerName       String?
  customerPhone      String?
  specialNotes       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  customerEmail      String?
  processedBy        String?
  aggregatorCut      Float       @default(0)
  aggregatorOrderId  String?
  netPayout          Float?
  bills              Bill[]
  cafe               Tenant      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  table              Table?      @relation(fields: [tableId], references: [id])
  items              OrderItem[]
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  menuItemId String?
  name       String
  price      Float
  quantity   Int       @default(1)
  status     String    @default("PENDING")
  notes      String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Bill {
  id            String   @id @default(cuid())
  cafeId        String
  orderId       String
  billNumber    String
  subtotal      Float
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  discount      Float    @default(0)
  total         Float
  cashAmount    Float?   @default(0)
  upiAmount     Float?   @default(0)
  paymentMethod String   @default("UPI")
  paymentStatus String   @default("PAID")
  customerPhone String?
  whatsappSent  Boolean  @default(false)
  createdAt     DateTime @default(now())
  customerEmail String?
  customerName  String?
  emailSent     Boolean  @default(false)
  processedBy   String?
  couponCode    String?
  cafe          Tenant   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id])
}

model CashShift {
  id            String    @id @default(cuid())
  cafeId        String
  userId        String?
  status        String    @default("OPEN")
  openingCash   Float     @default(0)
  cashSales     Float     @default(0)
  pettyExpenses Float     @default(0)
  expectedCash  Float     @default(0)
  countedCash   Float?
  discrepancy   Float?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  notes         String?
  cafe          Tenant    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id])
  expenses      Expense[]
}

model Expense {
  id          String     @id @default(cuid())
  cafeId      String
  shiftId     String?
  title       String
  amount      Float
  category    String     @default("INGREDIENTS")
  paidVia     String     @default("DRAWER_CASH")
  receiptNote String?
  createdAt   DateTime   @default(now())
  cafe        Tenant     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  shift       CashShift? @relation(fields: [shiftId], references: [id])
}

model Customer {
  id                String   @id @default(cuid())
  cafeId            String
  phone             String
  name              String?
  visitCount        Int      @default(1)
  totalSpend        Float    @default(0)
  lastVisitAt       DateTime @default(now())
  isOptedInWhatsApp Boolean  @default(true)
  ratingScore       Int?
  createdAt         DateTime @default(now())
  email             String?
  cafe              Tenant   @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, phone])
}

model PushSubscription {
  id        String   @id @default(cuid())
  cafeId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model InventoryItem {
  id            String               @id @default(cuid())
  cafeId        String
  name          String
  sku           String?
  unit          String               @default("g")
  currentStock  Float                @default(0)
  minStockAlert Float                @default(100)
  costPerUnit   Float?               @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  cafe          Tenant               @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  recipeUsage   MenuItemIngredient[]
}

model MenuItemIngredient {
  id              String        @id @default(cuid())
  menuItemId      String
  inventoryItemId String
  quantityNeeded  Float
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
}

model Coupon {
  id            String   @id @default(cuid())
  cafeId        String
  code          String
  discountType  String   @default("PERCENTAGE")
  discountValue Float
  minOrderValue Float    @default(0)
  maxDiscount   Float?
  isActive      Boolean  @default(true)
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cafe          Tenant   @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, code])
}
