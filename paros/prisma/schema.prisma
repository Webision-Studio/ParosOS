generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  address         String?
  city            String?
  phone           String?
  email           String?
  gstin           String?
  plan            String      @default("SILVER") // SILVER, GOLD
  qrMode          String      @default("MODE_A") // MODE_A (Universal QR)
  upiId           String?
  enableKds       Boolean     @default(true)
  enableWhatsapp  Boolean     @default(true)
  closingTime     String?     @default("23:00") // 24-hr format (e.g. "23:00" = 11:00 PM) for daily report email
  googleReviewUrl String?     // Direct Google Review link (e.g. https://maps.app.goo.gl/...)
  wifiName        String?     // Wi-Fi network name for printable QR cards
  wifiPassword    String?     // Wi-Fi password for printable QR cards
  cashierPin      String?     @default("1234") // 4-digit POS Cashier PIN
  kitchenPin      String?     @default("7788") // 4-digit Kitchen KDS PIN
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  users           User[]
  zones           Zone[]
  tables          Table[]
  categories      Category[]
  menuItems       MenuItem[]
  orders          Order[]
  bills           Bill[]
  shifts          CashShift[]
  expenses        Expense[]
  customers       Customer[]
  inventoryItems  InventoryItem[]
  coupons         Coupon[]
}

model User {
  id          String      @id @default(cuid())
  cafeId      String
  cafe        Tenant      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  role        String      @default("OWNER") // OWNER, MANAGER, CASHIER, KITCHEN
  pin         String?     // 4-digit PIN for terminal unlock
  firebaseUid String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  shifts      CashShift[]
}

model Zone {
  id        String    @id @default(cuid())
  cafeId    String
  cafe      Tenant    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  name      String    // e.g. "Main Indoor AC", "Patio & Garden"
  sortOrder Int       @default(0)
  tables    Table[]
}

model Table {
  id            String    @id @default(cuid())
  cafeId        String
  cafe          Tenant    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  zoneId        String?
  zone          Zone?     @relation(fields: [zoneId], references: [id])
  tableNumber   String    // e.g. "1", "2", "T4", "Takeaway"
  capacity      Int       @default(4)
  currentStatus String    @default("AVAILABLE") // AVAILABLE, OCCUPIED, BILLED
  activeOrderId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
}

model Category {
  id        String      @id @default(cuid())
  cafeId    String
  cafe      Tenant      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  name      String
  icon      String?     // Material Symbol name
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)

  menuItems MenuItem[]
}

model MenuItem {
  id              String      @id @default(cuid())
  cafeId          String
  cafe            Tenant      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  price           Float
  imageUrl        String?     // Supabase Storage URL for item photo
  isVeg           Boolean     @default(true)
  inStock         Boolean     @default(true) // 86 Sold-out toggle
  prepTimeMinutes Int         @default(8)

  orderItems      OrderItem[]
  recipes         MenuItemIngredient[]
}

model Order {
  id                  String      @id @default(cuid())
  cafeId              String
  cafe                Tenant      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  tableId             String?
  table               Table?      @relation(fields: [tableId], references: [id])
  orderNumber         String      // e.g. "#1042"
  source              String      @default("POS") // POS, QR, SWIGGY, ZOMATO, TAKEAWAY
  status              String      @default("PLACED") // PLACED, PREPARING, READY, SERVED, CANCELLED
  dynamicPrepMinutes  Int         @default(10)
  prepStartedAt       DateTime?
  readyAt             DateTime?
  customerName        String?
  customerPhone       String?
  customerEmail       String?
  specialNotes        String?
  processedBy         String?     // e.g. "Rahul (Cashier)" or "Table QR"
  aggregatorOrderId   String?     // e.g. "SWIG-9041" or "ZOM-1120"
  aggregatorCut       Float       @default(0) // Commission fee deducted (e.g. 20%)
  netPayout           Float?      // Net amount receivable by cafe
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  items               OrderItem[]
  bills               Bill[]
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String?
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id])
  name        String
  price       Float
  quantity    Int       @default(1)
  status      String    @default("PENDING") // PENDING, READY
  notes       String?   // e.g. "Oat Milk Sub (+40)"
}

model Bill {
  id              String    @id @default(cuid())
  cafeId          String
  cafe            Tenant    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  billNumber      String    // e.g. "INV-1042"
  subtotal        Float
  cgst            Float     @default(0) // 2.5%
  sgst            Float     @default(0) // 2.5%
  discount        Float     @default(0)
  couponCode      String?   // Applied coupon code (e.g. "WELCOME10")
  total           Float
  paymentMethod   String    @default("UPI") // CASH, UPI, CARD
  paymentStatus   String    @default("PAID") // PENDING, PAID
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  processedBy     String?   // e.g. "Rahul (Cashier)"
  whatsappSent    Boolean   @default(false)
  emailSent       Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model CashShift {
  id            String    @id @default(cuid())
  cafeId        String
  cafe          Tenant    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  status        String    @default("OPEN") // OPEN, CLOSED
  openingCash   Float     @default(0)
  cashSales     Float     @default(0)
  pettyExpenses Float     @default(0)
  expectedCash  Float     @default(0)
  countedCash   Float?
  discrepancy   Float?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  notes         String?

  expenses      Expense[]
}

model Expense {
  id          String      @id @default(cuid())
  cafeId      String
  cafe        Tenant      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  shiftId     String?
  shift       CashShift?  @relation(fields: [shiftId], references: [id])
  title       String      // e.g. "Fresh Milk (15L)"
  amount      Float
  category    String      @default("INGREDIENTS") // INGREDIENTS, PACKAGING, UTILITIES, MISC
  paidVia     String      @default("DRAWER_CASH") // DRAWER_CASH, UPI, OWNER_PERSONAL
  receiptNote String?
  createdAt   DateTime    @default(now())
}

model Customer {
  id                  String    @id @default(cuid())
  cafeId              String
  cafe                Tenant    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  phone               String
  name                String?
  email               String?
  visitCount          Int       @default(1)
  totalSpend          Float     @default(0)
  lastVisitAt         DateTime  @default(now())
  isOptedInWhatsApp   Boolean   @default(true)
  ratingScore         Int?
  createdAt           DateTime  @default(now())

  @@unique([cafeId, phone]) // One customer record per phone per cafe
}

model PushSubscription {
  id          String    @id @default(cuid())
  cafeId      String
  endpoint    String    @unique // Browser push endpoint URL
  p256dh      String    // Public key for encryption
  auth        String    // Auth secret
  createdAt   DateTime  @default(now())
}

model InventoryItem {
  id              String                @id @default(cuid())
  cafeId          String
  cafe            Tenant                @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  name            String                // e.g. "Specialty Coffee Beans", "Oat Milk", "Croissants"
  sku             String?               // e.g. "INV-BEANS-01"
  unit            String                @default("g") // g, ml, pcs, kg, L
  currentStock    Float                 @default(0)
  minStockAlert   Float                 @default(100) // Alert threshold when currentStock <= minStockAlert
  costPerUnit     Float?                @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  recipeUsage     MenuItemIngredient[]
}

model MenuItemIngredient {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityNeeded  Float         // e.g. 18 (grams of beans), 200 (ml of oat milk), 1 (piece)

  @@unique([menuItemId, inventoryItemId])
}

model Coupon {
  id              String    @id @default(cuid())
  cafeId          String
  cafe            Tenant    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  code            String    // e.g. "WELCOME10", "FLAT50"
  discountType    String    @default("PERCENTAGE") // PERCENTAGE, FLAT
  discountValue   Float     // e.g. 10 (for 10%) or 50 (for ₹50)
  minOrderValue   Float     @default(0) // Minimum subtotal required
  maxDiscount     Float?    // Optional cap for percentage discounts (e.g. max ₹100 off)
  isActive        Boolean   @default(true)
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([cafeId, code])
}

